import assets.resources.resources_rc


/* ───────────────────────────────
   SMART RENAME — DARK THEME QSS
   ─────────────────────────────── */

QWidget {
    font-family: 'Calibri', sans-serif;
    font-size: 13px;
    color: #f0f0f0;
}

QMainWindow {
    background-image: url(:/assets/SmartRename_BG_Gradient.png);

}

/* Title */

#titleLabel {
    font-size: 14pt;
    font-family: 'calibri', 'sans';
    font-weight: 600;

}

#filesPreviewLabel {
    font-weight: bold;
    font-size: 10pt;
    padding-left: 4px;
}

#outputLabel {
    font-weight: bold;
    font-size: 10pt;
    padding-left: 6px;
}
/* ───────────── BUTTONS ───────────── */
QPushButton {
    padding: 6px 14px;
    font-size: 13px;
    background-color: #2d2d2d;
    border: 1px solid #444;
    border-radius: 8px;
    color: white;
    transition: all 0.3s ease;
}

QPushButton:hover {
    background-color: #3c3c3c;
    border: 1px solid #5a5a5a;
    box-shadow: 0 0 4px 1px rgba(0, 120, 215, 0.5);
}

QPushButton:pressed {
    background-color: #0078d7;
    border: 1px solid #005a9e;
}

/* ───────────── LISTS ───────────── */
QListWidget {
    background-color: #2b2b2b;
    color: #f0f0f0;
    font-family: Consolas, monospace;
    font-size: 13px;
    border: 1px solid #444;
    border-radius: 8px;
    padding: 6px;
}

QListWidget::item:selected {
    background-color: #3a75c4;
    color: white;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: #333;
    border-radius: 4px;
}

/* ───────────── GROUP BOX ───────────── */
QGroupBox {
    border: 1px solid #444;
    border-radius: 10px;
    margin-top: 10px;
    margin-left: 10px;
    padding: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    font-weight: 600;
    color: #dddddd;
}

#bottomGroup {
    font-weight: bold;
}

#charsRemoveLabel {
    font-weight: bold;
}

/* ───────────── CHECKBOX ───────────── */
QCheckBox {
    spacing: 6px;
    font-weight: bold;
    margin-bottom: 10px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 3px;
    border: 1px solid #888;
    background-color: #48574e;
}

QCheckBox::indicator:checked {
    background-color: #383837;
    border: 1px solid #789483;
    image: url(:/assets/icons-check.png);
}

QCheckBox:disabled {
    color: #777777;
}

QCheckBox::indicator:disabled {
    image: url(:/assets/check-disabled.png);
    width: 15px;
    height: 15px;
    border: 1px solid #555555;
    background-color: #2a2a2a;
    border-radius: 3px;
}

QCheckBox::indicator:checked:disabled {
    background-color: #444444;
    border: 1px solid #666666;
}

QCheckBox::indicator:disabled:hover,
QCheckBox::indicator:disabled:pressed {
    background-color: #2a2a2a;
    border: 1px solid #555555;
}

/* ───────────── TOOLTIP ───────────── */
QToolTip {
    background-color: #2b2b2b;
    border: 2px solid #c8c8c8;
    border-radius: 8px;
    padding: 4px;
    font-size: 12px;
    font-family: 'Segoe UI', sans-serif;
    color: white;
}

/* ───────────── LINE EDIT ───────────── */
QLineEdit {
    background: #2b2b2b;
    border: none;
    border-radius: 8px;
    border-bottom: 1px solid #444;
    padding: 3px;
    color: #f0f0f0;
    min-height: 22px;
    max-height: 22px;
    selection-background-color: #0078d7;
    selection-color: white;
}

QLineEdit:disabled {
    border-bottom: 2px solid #b05a6c;
}

QLineEdit:focus {
    border-bottom: 1.5px solid #dbc98c;
}

QLineEdit:hover {
    border-bottom: 1.5px solid #5a5a5a;
}

QLineEdit:focus:hover {
    border-bottom: 2px solid #cfc186;
    background: #32353b;
}

/* ───────────── SCROLL AREA ───────────── */
QScrollArea {
    border: none;
    background: #2b2b2b;
}

/* ───────────── OVERLAY + SLIDE PANEL ───────────── */
QWidget#scrimOverlay {
    background-color: rgba(0,0,0,0.3);
}

#sidePanel {
    background: #222426;
    border-radius: 12px;
}

#helpPanel {
    background: #222426;
    border-radius: 12px;
}

#sidePanelTitle {
    font-size: 12pt;
    font-weight: bold;
}


QLabel {
    color: white;
}

QCheckBox {
    color: white;
}